# Domains
S3_DOMAIN=s3.binaryten.com.br
CONSOLE_DOMAIN=minio-console.binaryten.com.br
EMAIL=your-email@example.com

# MinIO root credentials (admin access to all buckets)
# MINIO_ROOT_USER: min 3 characters
# MINIO_ROOT_PASSWORD: min 8 characters (use: openssl rand -base64 32)
MINIO_ROOT_USER=your_minio_root_user
MINIO_ROOT_PASSWORD=your_minio_root_password
